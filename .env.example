# Copy to .env and adjust. Compose reads this automatically.
PORT=8000
# Path *inside the container*. Mount ./checkpoints via docker-compose.yml.
TIER1_CHECKPOINT=/app/checkpoints/tier1_mlaad.pt

# --- Live call demo (Twilio + SMS) -----------------------------------------
# TIER2_MODE=strict demands the four trained ONNX models via TIER2_MANIFEST.
# TIER2_MODE=demo uses the labelled signal-based demo ensemble (default locally).
TIER2_MODE=demo
# TIER2_MANIFEST=C:\secure\models\tier2-manifest.json

# Twilio SMS prevention alerts. Leave unset to run SMS in console mode
# (alerts are still shown on the dashboard /v1/live feed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
# Alert tuning: cooldown between SMS per session/kind; minimum running risk for
# a trigger-word SMS; both are optional.
ALERT_COOLDOWN_S=60
ALERT_TRIGGER_RISK=40
