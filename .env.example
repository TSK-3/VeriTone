# Copy to .env and adjust. Compose reads this automatically.
PORT=8000
# Path *inside the container*. Mount ./checkpoints via docker-compose.yml.
TIER1_CHECKPOINT=/app/checkpoints/tier1_mlaad.pt

# --- Live call demo (Twilio + SMS) -----------------------------------------
# TIER2_MODE=strict demands the four trained ONNX models via TIER2_MANIFEST.
# TIER2_MODE=demo uses the labelled signal-based demo ensemble (default locally).
TIER2_MODE=demo
# TIER2_MANIFEST=C:\secure\models\tier2-manifest.json

# Twilio SMS prevention alerts. Leave unset to run SMS in console mode
# (alerts are still shown on the dashboard /v1/live feed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
# Optional: content template SID (trial accounts can only send predefined
# templates — copy one starting with HX from Twilio Console → Content Tools).
# TWILIO_CONTENT_SID=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Alert tuning: cooldown between SMS per session/kind; minimum running risk for
# a trigger-word SMS; both are optional.
ALERT_COOLDOWN_S=60
ALERT_TRIGGER_RISK=40

# --- Durable encrypted audit store + consented speaker references ------------
# AUDIT_STORE=off disables persistence entirely (in-memory only).
# AUDIT_STORE_PATH is where the encrypted SQLite db lives (volume-mount in Docker).
# AUDIT_STORE_KEY is a Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Leave unset and a key is auto-generated at <db>.key and reused.
AUDIT_STORE=on
AUDIT_STORE_PATH=/app/audit/veritone-audit.db
# AUDIT_STORE_KEY=
